[Unit]
Description=Celery Worker
After=network.target

[Service]
Type=forking
User=APP_USER
Group=APP_GROUP
SyslogIdentifier=celery-worker
Environment=LOG_SUFFIX=celery_worker
Environment=CELERYD_NODES="worker@HOSTNAME"
Environment=DJANGO_SETTINGS_MODULE="settings.HOST_CLASS"
WorkingDirectory=/home/pivotal
ExecStart=/bin/sh -c '/home/pivotal/.venv/bin/celery -A celeryapp multi start worker \
  -n worker-HOSTNAME --concurrency=4 -Q celery --prefetch-multiplier=1 \
  --max-tasks-per-child=20 --max-memory-per-child=600000 --time-limit=14400 --soft-time-limit=12600 \
  --logfile=/var/log/django/celery_worker.log --pidfile=/run/celery/worker.pid \
  --loglevel=INFO --events'
ExecStop=/bin/sh -c '/home/pivotal/.venv/bin/celery multi stopwait worker'
ExecReload=/bin/sh -c '/home/pivotal/.venv/bin/celery multi restart worker'
Restart=always

# --- memory ceiling -------------------------------------------------------
# concurrency 4: 4x600MB + 400MB parent = ~2.8GB.
#
# --max-memory-per-child is only evaluated BETWEEN tasks, so a single task that
# never returns is never checked. On 2026-08-18 one child reached 6.6 GB - 11x
# the 600 MB target - and exhausted the host, which the ALB then failed and the
# ASG terminated. A cgroup ceiling is the only thing that bounds a task already
# in flight.
#
# Sized from measured per-child RSS, not the --max-memory-per-child design
# target. On gamma under ordinary load a child on the default queue reached
# 1782MB - three times the 600MB target - because that limit is only evaluated
# BETWEEN tasks and does not bound a task in flight.
#
# concurrency 4 x ~1.8GB + ~400MB parent = ~7.6GB expected worst case.
#
# The previous 4G ceiling on celery_worker was below its real working set: gamma
# recorded 19 OOM kills and 787 limit hits within ten minutes of coming up.
#
# Absolute, not a percentage. Concurrency is fixed in this unit, so the memory
# this workload needs is fixed too - it does not scale with host RAM. A
# percentage looked tidy and was wrong: at 10% the priority worker sat at 97% of
# its own ceiling while idle on an 8GB host, and the rabbitmq host (t3.large) and
# masterimage (m5.large) are both 8GB. They would have OOM-killed celery under
# any real load.
#
# No MemoryHigh: it throttles under reclaim rather than killing, which
# reproduces the exact stall this exists to prevent. A clean kill is better
# than a slow strangle.
#
# OOMPolicy=continue: the default (stop) would take the whole unit down when a
# single child is killed. With continue, systemd leaves the unit running and
# the celery parent respawns the child.
MemoryAccounting=yes
MemoryMax=10G
OOMPolicy=continue


[Install]
WantedBy=multi-user.target
