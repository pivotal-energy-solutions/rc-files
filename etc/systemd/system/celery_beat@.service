[Unit]
Description=Celery Beat %i
After=network.target

[Service]
User=APP_USER
Group=APP_GROUP
SyslogIdentifier=celery-beat-%i
Environment=LOG_SUFFIX=celery_beat_%i
Environment=DJANGO_SETTINGS_MODULE="settings.%i"
WorkingDirectory=/home/pivotal
ExecStart=/bin/sh -c '/home/pivotal/.venv/bin/celery -A celeryapp beat \
  --scheduler django_celery_beat.schedulers:DatabaseScheduler \
  --logfile=/var/log/django/celery_beat_%i.log --pidfile=/run/celery/celery_beat_%i.pid \
  --loglevel=INFO'
Restart=always

# --- memory ceiling -------------------------------------------------------
# ~365MB measured. Beat is described as "scheduler only", which tempts a small
# ceiling, but it loads the entire Django app - settings, models, the full
# import graph - so it costs the same as any other Django process. 512M gave it
# 1.4x headroom where every other unit here has 2.8x.
#
# This is the only ceiling that applies on the rabbitmq host: it runs five
# celery_beat@ instances and no workers at all. 5x1G against 7552MB is 66%,
# and measured total across all five is 1986MB.
#
# --max-memory-per-child is only evaluated BETWEEN tasks, so a single task that
# never returns is never checked. On 2026-08-18 one child reached 6.6 GB - 11x
# the 600 MB target - and exhausted the host, which the ALB then failed and the
# ASG terminated. A cgroup ceiling is the only thing that bounds a task already
# in flight.
#
# Absolute, not a percentage. Concurrency is fixed in this unit, so the memory
# this workload needs is fixed too - it does not scale with host RAM. A
# percentage looked tidy and was wrong: at 10% the priority worker sat at 97% of
# its own ceiling while idle on an 8GB host, and the rabbitmq host (t3.large) and
# masterimage (m5.large) are both 8GB. They would have OOM-killed celery under
# any real load.
#
# No MemoryHigh: it throttles under reclaim rather than killing, which
# reproduces the exact stall this exists to prevent. A clean kill is better
# than a slow strangle.
#
# OOMPolicy=continue: the default (stop) would take the whole unit down when a
# single child is killed. With continue, systemd leaves the unit running and
# the celery parent respawns the child.
MemoryAccounting=yes
MemoryMax=1G
OOMPolicy=continue


[Install]
WantedBy=multi-user.target
