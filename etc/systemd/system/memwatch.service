[Unit]
Description=Capture stack traces of processes crossing a memory threshold
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/memwatch
Restart=always
RestartSec=10

# Trips between the healthy steady state (~2.8 GB) and the celery_worker cgroup
# ceiling (~6.1 GB), so the stack is captured on the way up rather than after the
# OOM kill - the kill itself names only `python3.14`, which is every celery child.
#
# 10s rather than a tight loop: the cgroup handles containment, so this only has
# to catch the offender somewhere in its climb, not outrun it.
Environment=MEMWATCH_THRESHOLD_KB=4000000
Environment=MEMWATCH_INTERVAL=10

# This exists to diagnose memory exhaustion, so it must not contribute to it.
#
# 128M rather than 64M: a capture now also runs memwatch-record under the system
# python3, and the interpreter plus py-spy dumping a multi-GB target shares this
# cgroup. Being OOM-killed mid-capture would lose the very alert the capture
# exists to raise, and 128M is still negligible against a 16GB host.
MemoryAccounting=yes
MemoryMax=128M
OOMPolicy=continue
Nice=10

[Install]
WantedBy=multi-user.target
